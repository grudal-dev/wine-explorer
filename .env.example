DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://terroirs.example.com
# Laisser vide pour SQLite ; sinon :
# DATABASE_URL=postgres://terroirs:terroirs@localhost:5432/terroirs
BLINDTEST_MAX_ATTEMPTS=8
# Newsletter : en production, un vrai serveur SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Wine Explorer <newsletter@example.com>
# SITE_URL=https://example.com
# Décor de saison : auto (selon la date), off, ou medoc / montmartre / novello / beaujolais / vinjaune (forcé)
# SEASONAL_DECOR=auto
# Vin de la semaine dans le bandeau hors fête (true par défaut)
# WINE_OF_THE_WEEK=true
# Nom affiché partout (en-tête, titres, partage, e-mails) : un seul réglage pour changer de nom
# SITE_NAME=Wine Explorer
# Search Console de Google et Bing Webmaster Tools : contenu de la balise de vérification
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# Mentions légales. Particulier : laisser LEGAL_PUBLISHER vide (anonymat permis par la LCEN si l'hébergeur a votre identité)
# LEGAL_PUBLISHER=
# LEGAL_PUBLISHER_ADDRESS=
# LEGAL_PUBLISHER_ID=
# LEGAL_DIRECTOR=
# CONTACT_EMAIL=
# LEGAL_HOST=Railway Corporation, 548 Market St Suite 68956, San Francisco, California 94104, États-Unis
# Œnologue relecteur, affiché sur « À propos » une fois choisi
# DATA_REVIEWER=
